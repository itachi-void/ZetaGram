# ==========================================
# ZetaGram Bot Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated Telegram User IDs for Bot Administrators
ADMIN_IDS=123456789,987654321

# Default Required Channel for new users
REQUIRED_CHANNEL=@YourRequiredChannel
REQUIRED_CHANNEL_LINK=https://t.me/YourRequiredChannel

# Bot Display Name
BOT_NAME=ZetaGram

# ------------------------------------------
# Database & Persistence Settings
# ------------------------------------------
# For Local Run:
DATABASE_URL=sqlite+aiosqlite:///bot.db
PERSISTENCE_FILE=bot_persistence.pickle

# For Docker Deployments (Persistent Volume):
# DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db
# PERSISTENCE_FILE=/app/data/bot_persistence.pickle

# ------------------------------------------
# Optional Webhook Configuration
# Leave blank for default Polling mode
# ------------------------------------------
WEBHOOK_URL=
WEBHOOK_PORT=8080
WEBHOOK_SECRET_TOKEN=
